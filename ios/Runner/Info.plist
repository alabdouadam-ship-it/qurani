<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
	<dict>
		<key>CFBundleDevelopmentRegion</key>
		<string>$(DEVELOPMENT_LANGUAGE)</string>
		<key>CFBundleDisplayName</key>
		<string>Qurani</string>
		<key>CFBundleExecutable</key>
		<string>$(EXECUTABLE_NAME)</string>
		<key>CFBundleIdentifier</key>
		<string>com.qurani.ios</string>
		<key>CFBundleInfoDictionaryVersion</key>
		<string>6.0</string>
		<key>CFBundleName</key>
		<string>qurani</string>
		<key>CFBundlePackageType</key>
		<string>APPL</string>
		<key>CFBundleShortVersionString</key>
		<string>$(FLUTTER_BUILD_NAME)</string>
		<key>CFBundleSignature</key>
		<string>????</string>
		<key>CFBundleVersion</key>
		<string>$(FLUTTER_BUILD_NUMBER)</string>
		<key>LSRequiresIPhoneOS</key>
		<true/>
		<key>UILaunchStoryboardName</key>
		<string>LaunchScreen</string>
		<key>UIMainStoryboardFile</key>
		<string>Main</string>
		<key>UISupportedInterfaceOrientations</key>
		<array>
			<string>UIInterfaceOrientationPortrait</string>
			<string>UIInterfaceOrientationLandscapeLeft</string>
			<string>UIInterfaceOrientationLandscapeRight</string>
		</array>
		<key>UISupportedInterfaceOrientations~ipad</key>
		<array>
			<string>UIInterfaceOrientationPortrait</string>
			<string>UIInterfaceOrientationPortraitUpsideDown</string>
			<string>UIInterfaceOrientationLandscapeLeft</string>
			<string>UIInterfaceOrientationLandscapeRight</string>
		</array>
		<key>CADisableMinimumFrameDurationOnPhone</key>
		<true/>
		<key>UIApplicationSupportsIndirectInputEvents</key>
		<true/>
		<key>UIStatusBarHidden</key>
		<false/>
		<!-- Background audio only.
		     `fetch` and `remote-notification` were removed: the app has no
		     BGTaskScheduler work and no push provider (adhan and wird
		     reminders are LOCAL notifications scheduled via
		     flutter_local_notifications, and the prayer-times cache refresh
		     runs at launch, not in the background). Declaring unused
		     background modes is an App Review rejection risk. -->
		<key>UIBackgroundModes</key>
		<array>
			<string>audio</string>
		</array>
		<!-- Location for Qibla and Prayer Times.
		     When-in-use ONLY. `NSLocationAlwaysAndWhenInUseUsageDescription`
		     was removed: nothing here requests always-on authorization, and
		     asking for a stronger grant than we use invites review questions
		     plus a scarier prompt for the user. -->
		<key>NSLocationWhenInUseUsageDescription</key>
		<string>Qurani needs your location to determine Qibla direction and calculate accurate prayer times for your area.</string>
		<!-- No NSMicrophoneUsageDescription: nothing in the app records audio.
		     The audio session is configured for playback only
		     (AudioSessionConfiguration.music() in main.dart), so declaring
		     microphone access would prompt the user for a capability we never
		     use. -->
		<key>ITSAppUsesNonExemptEncryption</key>
		<false/>
	</dict>
</plist>

