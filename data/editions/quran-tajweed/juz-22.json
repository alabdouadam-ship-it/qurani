[ل]صَّ[n[ـٰ]بِرِينَ وَ[h:10804[ٱ][l[ل]صَّ[n[ـٰ]بِر[n[َٲ]تِ وَ[h:10805[ٱ]لْخَ[n[ـٰ]شِعِينَ وَ[h:10806[ٱ]لْخَ[n[ـٰ]شِعَ[n[ـٰ]تِ وَ[h:10807[ٱ]لْمُتَصَدِّقِينَ وَ[h:10808[ٱ]لْمُتَصَدِّقَ[n[ـٰ]تِ وَ[h:10809[ٱ][l[ل]صَّ[o[ـٰٓ]ئِمِينَ وَ[h:10810[ٱ][l[ل]صَّ[o[ـٰٓ]ئِمَ[n[ـٰ]تِ وَ[h:10811[ٱ]لْحَ[n[ـٰ]فِظِينَ فُرُوجَهُمْ وَ[h:10812[ٱ]لْحَ[n[ـٰ]فِظَ[n[ـٰ]تِ وَ[h:10813[ٱ][l[ل]ذّ[n[َٲ]كِرِينَ [h:10814[ٱ]للَّهَ كَثِي[a:10815[رًا و]َ[h:10816[ٱ][l[ل]ذّ[n[َٲ]كِر[n[َٲ]تِ أَعَدَّ [h:5775[ٱ]للَّهُ لَه[w:10817[ُم م]َّغْفِرَ[a:10818[ةً و]َأَ[q:10819[جْ]رًا عَظِيمًا"},{"number":3569,"numberInSurah":36,"juz":22,"page":423,"text":"وَمَا كَانَ لِمُؤْمِ[a:10820[نٍ و]َلَا مُؤْمِنَةٍ إِذَا قَضَى [h:10821[ٱ]للَّهُ وَرَسُولُهُ[o[ۥٓ] أَمْرًا أ[a:3312[َن ي]َكُونَ لَهُمُ [h:10226[ٱ]لْخِيَرَةُ مِنْ أَمْرِهِمْۗ وَم[a:2634[َن ي]َعْصِ [h:2635[ٱ]للَّهَ وَرَسُولَهُ[n[ۥ] فَقَ[q:563[دْ] ضَلَّ ضَلَ[n[ـٰ]ل[a:10822[اً م]ُّبِينًا"},{"number":3570,"numberInSurah":37,"juz":22,"page":423,"text":"وَإِذْ تَقُولُ لِلَّذ[o[ِىٓ] أَنْعَمَ [h:2900[ٱ]للَّهُ عَلَيْهِ وَأَنْعَمْتَ عَلَيْهِ أَمْسِكْ عَلَيْكَ زَوْجَكَ وَ[h:10823[ٱ]تَّقِ [h:10824[ٱ]للَّهَ وَتُخْفِى فِى نَفْسِكَ مَا [h:10825[ٱ]للَّهُ مُ[q:10826[بْ]دِيهِ وَتَخْشَى [h:10827[ٱ][l[ل][g[نّ]َاسَ وَ[h:72[ٱ]للَّهُ أَحَقُّ أَ[f:10828[ن ت]َخْشَ[n[ـٰ]هُۖ فَلَ[g[مّ]َا قَضَىٰ زَيْ[a:10829[دٌ م]ِّنْهَا وَطَ[f:10830[رًا ز]َوَّ[q:10831[جْ]نَ[n[ـٰ]كَهَا لِكَىْ لَا يَكُونَ عَلَى [h:2329[ٱ]لْمُؤْمِنِينَ حَرَ[f:10832[جٌ ف][o[ِىٓ] أَزْو[n[َٲ]جِ أَ[q:10833[دْ]عِي[o[َا]ٓئِهِمْ إِذَا قَضَوْ[s[اْ] مِنْهُ[g[نّ]َ وَطَ[a:10834[رًاۚ و]َكَانَ أَمْرُ [h:2832[ٱ]للَّهِ مَفْعُولاً"},{"number":3571,"numberInSurah":38,"juz":22,"page":423,"text":"مَّا كَانَ عَلَى [h:5875[ٱ][l[ل][g[نّ]َبِىِّ مِنْ حَرَ[f:10835[جٍ ف]ِيمَا فَرَضَ [h:10836[ٱ]للَّهُ لَهُۖ[n[ۥ] سُ[g[نّ]َةَ [h:10837[ٱ]للَّهِ فِى [h:6320[ٱ]لَّذِينَ خَلَوْ[s[اْ] مِ[f:128[ن ق]َ[q:129[بْ]لُۚ وَكَانَ أَمْرُ [h:2832[ٱ]للَّهِ قَدَ[a:10838[رًا م]َّ[q:10839[قْ]دُورًا"},{"number":3572,"numberInSurah":39,"juz":22,"page":423,"text":"ٱلَّذِينَ يُبَلِّغُ